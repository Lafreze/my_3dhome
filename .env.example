# The only public asset setting. Empty keeps all assets local at /assets.
# Set this at BUILD time, after upload and verification:
VITE_ASSET_BASE_URL=
# VITE_ASSET_BASE_URL=https://assets.kuro.cafe/kuro

# Upload machine / CI only. These must NEVER use a VITE_ prefix.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional; default is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional externally issued prefix-scoped upload session (all three keys required).
R2_SESSION_TOKEN=

# Server runtime only. Set the initial passphrase in Railway, never in VITE_*.
STUDIO_ADMIN_PASSWORD=
STUDIO_PUBLIC_ORIGIN=https://kuro.cafe
# Railway persistent volume mount; local default is output/server-data.
STUDIO_DATA_DIR=/data
