{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1",
    "build": "vinext build",
    "start": "node scripts/serve-local.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "predev": "npm run assets:prepare",
    "prebuild": "node scripts/prepare-assets.mjs --build",
    "typecheck": "tsc --noEmit",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:upload": "node --env-file-if-exists=.env.r2.local scripts/upload-r2-assets.mjs",
    "assets:verify": "node --env-file-if-exists=.env.r2.local scripts/verify-r2-assets.mjs",
    "assets:check": "node --test scripts/check-assets.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@base-ui/react": "1.7.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "draco3dgltf": "^1.5.7",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "meshoptimizer": "^1.2.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
